# Número de WhatsApp dos consultores, formato internacional sem símbolos
# (ex: 5541998402800). Usado em todos os CTAs "Falar com um consultor".
# Opcional: o número real já é o padrão em src/lib/whatsapp.ts — só defina
# isso se algum ambiente (staging, teste) precisar de um número diferente.
PUBLIC_WHATSAPP_NUMBER=5541998402800

# URL do webhook do agente de tira-dúvidas (n8n) usado pelo popup do site
# (AssistantePopup.astro). Sem credencial exigida — protegido por limite
# diário no próprio workflow. Opcional: a URL real já é o padrão em
# src/lib/assistant.ts — só defina isso se algum ambiente precisar apontar
# para um workflow diferente (ex: staging).
PUBLIC_ASSISTENTE_URL=https://n8n-m5uf.srv1833354.hstgr.cloud/webhook/popup-agente-ia-fenie

# ---------------------------------------------------------------------------
# MEDIÇÃO — briefing cap. 15. Enquanto estas duas estiverem vazias, o site vai
# ao ar SEM NENHUM script de terceiro: os snippets simplesmente não são
# renderizados. A camada de eventos roda de qualquer jeito e empilha tudo em
# window.dataLayer, então dá para abrir o console do navegador e conferir se
# cada evento dispara ANTES de ligar o pixel.
# ---------------------------------------------------------------------------

# ID do pixel da Meta. Só dígitos, sem "fbq" e sem aspas.
# Onde achar: Gerenciador de Anúncios → Gerenciador de Eventos → Fontes de
# dados. É o número que aparece embaixo do nome do pixel.
# Ex.: 1234567890123456
PUBLIC_META_PIXEL_ID=

# ID de medição do GA4, no formato G-XXXXXXXXXX. NÃO é o ID do fluxo de dados
# nem o "UA-" antigo.
# Onde achar: Google Analytics → Administrador → Fluxos de dados → clique no
# fluxo do site → "ID de medição", canto superior direito.
# Ex.: G-AB12CD34EF
PUBLIC_GA4_ID=

# ---------------------------------------------------------------------------
# COMERCIAL
# ---------------------------------------------------------------------------

# URL do catálogo B2B. O site não substitui o catálogo, só direciona
# (briefing cap. 11). Enquanto estiver vazia, o bloco "Já é cliente
# cadastrado?" em /comprar NÃO é renderizado — nada de link quebrado nem de
# botão "em breve" em produção.
# Ex.: https://catalogo.feniecosmeticos.com.br
PUBLIC_CATALOGO_URL=
