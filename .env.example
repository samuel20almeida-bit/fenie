# Número de WhatsApp dos consultores, formato internacional sem símbolos
# (ex: 554198402800). Usado em todos os CTAs "Falar com um consultor".
# Opcional: o número real já é o padrão em src/lib/whatsapp.ts — só defina
# isso se algum ambiente (staging, teste) precisar de um número diferente.
PUBLIC_WHATSAPP_NUMBER=554198402800

# URL do webhook do agente de tira-dúvidas (n8n) usado pelo popup do site
# (AssistantePopup.astro). Sem credencial exigida — protegido por limite
# diário no próprio workflow. Opcional: a URL real já é o padrão em
# src/lib/assistant.ts — só defina isso se algum ambiente precisar apontar
# para um workflow diferente (ex: staging).
PUBLIC_ASSISTENTE_URL=https://n8n-m5uf.srv1833354.hstgr.cloud/webhook/e370460c-f08a-47fc-86db-cec5d9977d74/popup-agente-ia-fenie
