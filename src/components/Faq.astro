---
import { faq } from "../data/faq";
---

<section class="bg-midnight-alt py-26">
  <div class="container-editorial">
    <div class="max-w-160">
      <h2 class="reveal text-[clamp(1.6rem,3vw,2.2rem)]">Perguntas frequentes</h2>

      <div class="mt-10 border-t border-border">
        {
          faq.map((item) => (
            <details class="reveal group border-b border-border py-6">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 marker:content-none">
                <span class="font-body text-h3 font-semibold">{item.q}</span>
                <svg
                  class="h-4 w-4 shrink-0 text-gold transition-transform duration-(--dur-hover-card) ease-(--ease-editorial) group-open:rotate-45"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="mt-3.5 max-w-[62ch] text-sm text-platina">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
