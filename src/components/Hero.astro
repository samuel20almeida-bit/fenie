---
import Button from "./Button.astro";
import { whatsappLink } from "../lib/whatsapp";

// Key visual real da Olenka (Rodrigo Cintra, embaixador técnico da marca),
// fornecido pela Fenié — não é banco de imagem nem IA.
//
// A foto entra inteira, sem recorte e sem moldura: no desktop ela ocupa a
// faixa direita da seção em altura cheia, e um gradiente dissolve o lado
// esquerdo dela no fundo da página. Como o fundo do próprio material
// (#161925) é quase o midnight do tema, não existe emenda visível — a
// página e a foto viram uma superfície só. No mobile a mesma foto entra no
// fluxo, abaixo do texto, dissolvendo pelo topo em vez de pela lateral.
---

<section class="relative overflow-hidden border-b border-border-subtle pt-33 pb-24 lg:min-h-[660px]">
  <div
    class="absolute inset-0"
    style="background: radial-gradient(ellipse 900px 480px at 82% -10%, color-mix(in oklab, var(--color-gold) 10%, transparent), transparent 60%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-editorial relative z-10">
    <div class="reveal lg:max-w-[32rem]">
      <div class="mb-6 w-10 border-t border-gold" aria-hidden="true"></div>
      <p class="eyebrow mb-5">Distribuição profissional · Curitiba e região</p>
      {/* A headline lidera pela realidade do salão, não pelo que a Fenié
      vende: "produtos profissionais" era a primeira coisa que o visitante
      lia, e é exatamente a percepção que o reposicionamento quer deixar
      para trás. */}
      <h1 class="max-w-[17ch] text-[clamp(2.4rem,4.6vw,3.7rem)]">
        Seu salão precisa de mais do que bons <em>produtos</em>.
      </h1>
      <p class="mt-7 max-w-[46ch] text-lg text-platina">
        A Fenié reúne marcas selecionadas, conhecimento técnico e suporte comercial próximo para o
        salão comprar melhor, desenvolver a equipe e crescer com consistência.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <Button href={whatsappLink("Olá! Vim pelo site da Fenié Pro e quero falar com um consultor.")}>
          Falar com um consultor
        </Button>
        <Button href="#metodo" variant="outline">Como a Fenié trabalha →</Button>
      </div>
      <p class="mt-4 font-mono text-micro tracking-wide text-platina">
        Atendimento por consultor da sua região · Sem compromisso de compra
      </p>
    </div>
  </div>

  {
    /* Depois do texto no DOM para cair abaixo dele no mobile; no desktop sai
    do fluxo e o z-10 do conteúdo garante que o texto continue por cima. */
  }
  <div class="relative z-0 mt-14 lg:absolute lg:inset-y-0 lg:right-0 lg:mt-0 lg:w-[54%] lg:overflow-hidden">
    <img
      src="/images/hero/olenka-royal-look.webp"
      alt="Linha profissional Olenka — kit Royal Look, Banho de Colágeno e Blend de Proteínas — com Rodrigo Cintra, embaixador técnico da marca"
      width="1800"
      height="1445"
      fetchpriority="high"
      decoding="async"
      class="w-full lg:absolute lg:top-0 lg:right-0 lg:h-full lg:w-auto lg:max-w-none"
    />
    {
      /* O segundo gradiente (to top) existe porque a base da foto é o pódio
      claro: sem ele, a foto corta seco contra a faixa escura da seção
      seguinte e a emenda aparece. Mesma lógica de dissolver da lateral,
      aplicada embaixo. */
    }
    <div
      class="absolute inset-0 lg:hidden"
      style="background:
        linear-gradient(to bottom, var(--color-midnight), color-mix(in srgb, var(--color-midnight) 30%, transparent) 34%, transparent 62%),
        linear-gradient(to top, var(--color-midnight) 0%, color-mix(in srgb, var(--color-midnight) 55%, transparent) 11%, transparent 32%);"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 hidden lg:block"
      style="background:
        linear-gradient(to right, var(--color-midnight), color-mix(in srgb, var(--color-midnight) 62%, transparent) 26%, transparent 58%),
        linear-gradient(to top, var(--color-midnight) 0%, color-mix(in srgb, var(--color-midnight) 55%, transparent) 11%, transparent 32%);"
      aria-hidden="true"
    >
    </div>
  </div>
</section>
