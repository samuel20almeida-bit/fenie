---
import Button from "./Button.astro";
import { whatsappLink } from "../lib/whatsapp";
---

<section
  class="border-b border-white/10 pt-33 pb-26"
  style="background: radial-gradient(ellipse 900px 480px at 82% -10%, color-mix(in oklab, var(--color-gold) 10%, transparent), transparent 60%);"
>
  <div class="container-editorial grid items-center gap-18 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="reveal">
      <p class="eyebrow mb-5">Distribuição profissional · Curitiba e região</p>
      <h1 class="max-w-[16ch] text-[clamp(2.4rem,4.6vw,4rem)]">
        Produtos profissionais, conhecimento técnico e <em>suporte</em> para o seu salão crescer.
      </h1>
      <p class="mt-6.5 max-w-[48ch] text-lg text-platina">
        A Fenié Pro conecta salões e profissionais da beleza a marcas selecionadas, atendimento
        consultivo, capacitação e uma operação comercial próxima.
      </p>
      <div class="mt-8.5 flex flex-wrap gap-4">
        <Button href={whatsappLink("Olá! Vim pelo site da Fenié Pro e quero falar com um consultor.")}>
          Falar com um consultor
        </Button>
        <Button href="/marcas" variant="outline">Conhecer as marcas →</Button>
      </div>
      <p class="mt-3.5 font-mono text-micro tracking-wide text-platina">
        Atendimento por consultor da sua região · Sem compromisso de compra
      </p>
    </div>

    {
      /* Espaço reservado para a foto real (consultora Fenié atendendo um salão
      parceiro: bastidor real, não still de produto — briefing cap. 09, nunca
      IA). Até a foto chegar, a onda da marca substitui o hachurado genérico
      do PlaceholderMedia no espaço mais visível do site. */
    }
    <div class="reveal relative flex h-[420px] items-center justify-center overflow-hidden rounded-editorial border border-white/10 bg-midnight-card lg:h-[520px]">
      <div
        class="absolute inset-0"
        style="background: radial-gradient(ellipse 65% 55% at 50% 45%, color-mix(in oklab, var(--color-gold) 16%, transparent), transparent 70%);"
        aria-hidden="true"
      />
      <img
        src="/images/logo/fenie-pro-mark.webp"
        alt=""
        aria-hidden="true"
        class="relative w-[62%] max-w-90 opacity-95"
      />
    </div>
  </div>
</section>
