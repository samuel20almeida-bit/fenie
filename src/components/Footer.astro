---
import { whatsappLink } from "../lib/whatsapp";

const columns = [
  {
    title: "Explore",
    links: [
      { label: "A Fenié", href: "/a-fenie" },
      { label: "Marcas", href: "/marcas" },
      { label: "Soluções", href: "/solucoes" },
    ],
  },
  {
    title: "Academy",
    links: [
      { label: "Fenié Academy", href: "/academy" },
      { label: "Agenda de cursos", href: "/academy#agenda" },
      { label: "Educadores", href: "/academy#educadores" },
    ],
  },
  {
    title: "Atendimento",
    links: [
      { label: "Contato", href: "/contato" },
      { label: "Cadastro profissional", href: "/contato#cadastro" },
    ],
  },
];
---

<footer class="border-t border-white/10 bg-midnight">
  <div class="container-immersive grid gap-12 py-19 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <p class="font-body text-[19px] font-bold tracking-wide uppercase">
        Fenié <span class="text-gold">Pro</span>
      </p>
      <p class="mt-3.5 max-w-[32ch] text-sm text-platina">
        Produtos profissionais, conhecimento técnico e suporte comercial para salões e
        profissionais da beleza.
      </p>
      <a
        href={whatsappLink("Olá! Vim pelo site da Fenié Pro e quero falar com um consultor.")}
        class="mt-4 inline-block border-b border-gold pb-0.5 text-[13.5px] font-semibold text-bone hover:text-gold"
      >
        Falar com um consultor →
      </a>
    </div>

    {
      columns.map((col) => (
        <div>
          <p class="eyebrow mb-4">{col.title}</p>
          <div class="flex flex-col gap-2.5">
            {col.links.map((link) => (
              <a href={link.href} class="text-sm text-platina hover:text-gold">
                {link.label}
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</footer>
