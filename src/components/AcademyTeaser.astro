---
import Button from "./Button.astro";
import CourseCard from "./CourseCard.astro";
import PlaceholderMedia from "./PlaceholderMedia.astro";
import { cursoDestaque } from "../data/cursos";
---

<section class="bg-midnight-alt py-26">
  <div class="container-editorial grid items-center gap-16 lg:grid-cols-2">
    <PlaceholderMedia
      class="reveal order-2 h-95"
      caption="Turma da Fenié Academy em aula prática"
    />

    <div class="reveal order-1">
      <p class="eyebrow mb-4">Fenié Academy</p>
      <h2 class="text-[clamp(1.7rem,2.8vw,2.2rem)]">
        Conhecimento técnico para transformar prática em <em>evolução</em> profissional.
      </h2>
      <p class="mt-4.5 max-w-[48ch] text-platina">
        A Fenié Academy reúne cursos técnicos, formações e imersões profissionais para quem vive
        da beleza e busca evolução real, segurança técnica e crescimento no salão.
      </p>
      <Button href="/academy" variant="outline" class="mt-6.5">Ver agenda de cursos →</Button>

      <CourseCard curso={cursoDestaque} class="mt-8" />
    </div>
  </div>
</section>
