---
import { empresa, enderecoLinha, mapaLink } from "../data/empresa";

const items = [
  { label: "Endereço", value: enderecoLinha, href: mapaLink, external: true },
  { label: "Telefone", value: empresa.telefone, href: `tel:${empresa.telefoneE164}` },
  { label: "E-mail", value: empresa.email, href: `mailto:${empresa.email}` },
  { label: "Atendimento", value: empresa.horario },
];
---

<div class="border-t border-border pt-14">
  <p class="eyebrow mb-5">Onde encontrar a Fenié</p>

  {/* `overflow-wrap: anywhere` no valor, e não `break-word`: só o `anywhere`
      encolhe a contribuição de min-content, que é o que o grid usa para
      dimensionar a coluna. O e-mail tem 30 caracteres sem espaço e, sem isso,
      empurrava as QUATRO células para 316px num viewport de 320 — 21px de
      rolagem horizontal na página inteira a 320px. O rodapé já resolvia o
      mesmo caso com `break-all`; aqui tinha passado. */}
  <dl class="grid gap-px border border-border bg-border sm:grid-cols-2">
    {
      items.map((item) => (
        <div class="bg-midnight p-6">
          <dt class="eyebrow text-platina">{item.label}</dt>
          <dd class="mt-2 font-body text-base text-bone [overflow-wrap:anywhere]">
            {item.href ? (
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener" : undefined}
                class="inline-block py-1 hover:text-gold"
              >
                {item.value}
              </a>
            ) : (
              item.value
            )}
          </dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
    <p class="eyebrow text-platina">Redes</p>
    {
      empresa.redes.map((rede) => (
        <a
          href={rede.href}
          target="_blank"
          rel="noopener"
          class="border-b border-border pt-1 pb-0.5 text-caption font-semibold text-platina hover:border-gold hover:text-gold"
        >
          {rede.label} <span class="font-mono text-micro">{rede.handle}</span>
        </a>
      ))
    }
  </div>
</div>
