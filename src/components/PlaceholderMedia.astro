---
// Espaço reservado para fotografia real (briefing cap. 09 — packshot e
// foto de gente trabalhando, sempre material oficial, nunca gerado por IA).
// Some sozinho assim que o acervo fotográfico for entregue: basta trocar
// por um <img> normal onde este componente é usado.
interface Props {
  label?: string;
  caption?: string;
  rounded?: boolean;
  class?: string;
}

const { label = "Fotografia real", caption, rounded = true, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "flex flex-col items-center justify-center gap-1.5 border border-white/10 bg-midnight-card p-6 text-center",
    rounded && "rounded-editorial",
    className,
  ]}
  style="background-image: repeating-linear-gradient(135deg, color-mix(in oklab, var(--color-gold) 10%, transparent) 0px, color-mix(in oklab, var(--color-gold) 10%, transparent) 1px, transparent 1px, transparent 15px);"
>
  <span class="eyebrow">{label}</span>
  {caption && <p class="max-w-[24ch] font-body text-caption text-bone">{caption}</p>}
</div>
