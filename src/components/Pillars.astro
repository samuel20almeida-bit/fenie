---
const pillars = [
  {
    n: "01",
    title: "Atendimento consultivo",
    text: "Entendemos a realidade do seu salão para apoiar decisões de marcas, linhas e oportunidades adequadas ao seu negócio.",
    icon: "M4 5h16v11H8l-4 4V5z M8.5 10.5l2 2 5-5",
  },
  {
    n: "02",
    title: "Suporte técnico + Educação",
    text: "Orientação, conteúdo técnico e capacitação para ampliar segurança, repertório e evolução profissional.",
    icon: "M4 6.5c2.5-1.3 5-1.3 8 0v13c-3-1.3-5.5-1.3-8 0v-13z M20 6.5c-2.5-1.3-5-1.3-8 0v13c3-1.3 5.5-1.3 8 0v-13z",
  },
  {
    n: "03",
    title: "Operação próxima",
    text: "Relacionamento, reposição e continuidade comercial para acompanhar o salão depois da primeira compra.",
    icon: "M4 12a8 8 0 0 1 13.6-5.7L20 8 M20 4v4h-4 M20 12a8 8 0 0 1-13.6 5.7L4 16 M4 20v-4h4",
  },
];
---

<section class="bg-midnight-alt py-26">
  <div class="container-editorial">
    <div class="reveal mb-14 max-w-[60ch]">
      <p class="eyebrow mb-4">Como trabalhamos</p>
      <h2 class="text-[clamp(1.8rem,3vw,2.4rem)]">
        Mais que <em>distribuição</em>.
      </h2>
      <p class="mt-4 max-w-[52ch] text-platina">
        Uma parceria estratégica focada no desenvolvimento contínuo do seu negócio de beleza,
        através de três pilares fundamentais.
      </p>
    </div>

    <div class="grid gap-px border border-white/10 bg-white/10 md:grid-cols-3">
      {
        pillars.map((pillar, i) => (
          <div
            class="reveal bg-midnight-alt p-8"
            style={`transition-delay: ${i * 75}ms`}
          >
            <svg
              class="h-6.5 w-6.5 text-gold"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={pillar.icon} />
            </svg>
            <p class="eyebrow mt-4.5 text-platina">{pillar.n}</p>
            <h3 class="mt-2 font-body text-[1.05rem] font-semibold">{pillar.title}</h3>
            <p class="mt-2.5 text-[0.92rem] text-platina">{pillar.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
