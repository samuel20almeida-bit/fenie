---
import { whatsappLink } from "../lib/whatsapp";
import Button from "./Button.astro";

const waHref = whatsappLink(
  "Olá! Vim pelo site da Fenié Pro e quero falar com um consultor."
);

// "Comprar" primeiro: é a jornada que o site não oferecia, e o menu é onde
// quem chega decidido procura antes de rolar a página.
const nav = [
  { label: "Comprar", href: "/comprar" },
  { label: "Marcas", href: "/marcas" },
  { label: "Soluções", href: "/solucoes" },
  { label: "Academy", href: "/academy" },
  { label: "A Fenié", href: "/a-fenie" },
  { label: "Contato", href: "/contato" },
];
---

<header class="sticky top-0 z-20 border-b border-border bg-midnight/95 backdrop-blur">
  <div class="container-immersive flex items-center justify-between gap-6 py-5">
    <a href="/" class="shrink-0">
      <img
        src="/images/logo/fenie-pro-logo.webp"
        alt="Fenié Pro"
        width="900"
        height="626"
        class="h-10 w-auto sm:h-12"
      />
    </a>

    {
      /* Navegação completa só a partir de lg. Em md (768px, iPad retrato) os
      cinco itens + logo + CTA somavam mais que a largura útil e a página
      rolava na horizontal — o tablet fica com o mesmo menu do mobile, que
      cabe com folga. */
    }
    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navegação principal">
      {
        nav.map((item) => (
          <a href={item.href} class="text-sm font-medium text-bone transition-colors hover:text-gold">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      {
        /* Abaixo de sm o rótulo inteiro não cabe ao lado da logo e do menu:
        em 320/360px empurrava a página para rolar na horizontal. Em vez de
        espremer a fonte até o ilegível, o mobile ganha o botão redondo do
        WhatsApp (44px de área de toque) e o menu carrega o CTA com rótulo. */
      }
      <a
        href={waHref}
        aria-label="Falar com um consultor no WhatsApp"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold text-midnight transition-transform duration-(--dur-hover-btn) ease-(--ease-editorial) active:scale-[0.97] sm:hidden pointer-fine:hover:scale-[1.02] pointer-fine:hover:bg-gold-hover"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.17c-.24.68-1.4 1.3-1.94 1.35-.5.05-1.13.07-1.82-.11-.42-.11-.96-.29-1.65-.59-2.9-1.25-4.8-4.17-4.95-4.36-.14-.19-1.18-1.57-1.18-3s.75-2.13 1.02-2.42c.27-.29.58-.36.78-.36l.56.01c.18 0 .42-.07.66.5.24.59.83 2.02.9 2.17.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.17-.3.37-.42.5-.14.14-.29.29-.12.57.17.29.74 1.22 1.59 1.98 1.09.97 2.01 1.27 2.3 1.41.29.14.45.12.62-.07.17-.19.71-.83.9-1.12.19-.29.38-.24.64-.14.26.09 1.68.79 1.97.94.29.14.48.21.55.33.07.12.07.69-.17 1.36Z"
          />
        </svg>
      </a>

      {
        /* O `hidden` vai no wrapper, não no Button: a base do Button já traz
        `inline-flex`, e duas utilities de display no mesmo elemento não têm
        vencedor previsível — foi assim que a versão anterior deste header
        ficou com uma classe morta que nunca escondia nada. */
      }
      <div class="hidden sm:block">
        <Button href={waHref} size="compact">Falar com um consultor</Button>
      </div>

      <details class="relative lg:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-border text-bone transition-colors hover:border-gold hover:text-gold [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menu"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" />
          </svg>
        </summary>
        <nav
          class="absolute top-[calc(100%+0.75rem)] right-0 w-64 rounded-editorial border border-border bg-midnight-card p-2 shadow-xl"
          aria-label="Navegação principal"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="block rounded-editorial px-4 py-3 text-sm font-medium text-bone hover:bg-midnight-hover hover:text-gold"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={waHref}
            class="mt-1 block rounded-editorial border-t border-border px-4 py-3 text-sm font-semibold text-gold"
          >
            Falar com um consultor →
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("header details");
  if (menu) {
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.open = false;
      });
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) menu.open = false;
    });
  }
</script>
