---
import { whatsappLink } from "../lib/whatsapp";
import { ASSISTANT_URL } from "../lib/assistant";

// A cara do chat é um porte do "chat-messages" (React + framer-motion +
// lucide-react) para Astro. O site é estático por regra do projeto, então
// nada disso foi instalado: a animação virou keyframes CSS e os ícones,
// SVG inline.
//
// O que veio do original: avatar da assistente ao lado da fala dela, cabeçalho
// com identidade, entrada das bolhas com deslocamento lateral, canto do balão
// "apontando" para quem falou, indicador de digitação com os três pontos
// subindo em cascata, e o botão de enviar acendendo só quando há texto.
//
// O que ficou de fora: a paleta indigo/violeta e zinc do original (aqui é
// midnight + gold), e todo o aparato de demonstração — autoplay, botão de
// "replay", mensagens de exemplo. Isto é um chat de verdade, não uma vitrine
// de componente: reproduzir uma conversa fake com a marca da Fenié seria
// inventar atendimento que não aconteceu.
//
// A persona da Feni não mora aqui — mora no prompt do agente no n8n. O que o
// site precisa sustentar é a mesma promessa: ela é assistente virtual e não
// finge ser gente, e por isso está escrito no cabeçalho.
const wa = whatsappLink("Olá! Vim do assistente do site e quero continuar com um consultor.");
---

<div
  id="assistente-popup"
  data-assistant-url={ASSISTANT_URL}
  class="fixed right-5 bottom-5 z-30 flex flex-col items-end gap-3 sm:right-6 sm:bottom-6"
>
  <div
    id="assistente-panel"
    hidden
    class="flex w-[min(370px,calc(100vw-2.5rem))] max-h-[min(62vh,30rem)] origin-bottom-right flex-col overflow-hidden rounded-editorial border border-border bg-midnight-card shadow-2xl"
  >
    <header class="flex items-center gap-3 border-b border-border px-4 py-3.5">
      <span class="feni-avatar" aria-hidden="true">
        <img src="/images/assistente/feni.webp" alt="" width="256" height="256" />
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-body text-sm font-bold text-bone">Feni</p>
        <p class="mt-0.5 flex items-center gap-1.5 font-mono text-micro tracking-wide text-platina">
          <span class="feni-status" aria-hidden="true"></span>
          Assistente virtual da Fenié
        </p>
      </div>
      <button
        id="assistente-fechar"
        type="button"
        aria-label="Fechar assistente"
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-platina transition-colors hover:bg-midnight-hover hover:text-gold"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" />
        </svg>
      </button>
    </header>

    <div
      id="assistente-mensagens"
      class="flex-1 space-y-3.5 overflow-y-auto px-4 py-4"
      role="log"
      aria-live="polite"
      aria-label="Conversa com a Feni"
    >
    </div>

    <form id="assistente-form" class="border-t border-border p-3">
      <label for="assistente-input" class="sr-only">Digite sua dúvida</label>
      <div class="flex items-center gap-2 rounded-full border border-border bg-midnight px-4 py-1.5 transition-colors duration-(--dur-hover-btn) ease-(--ease-editorial) focus-within:border-gold">
        <input
          id="assistente-input"
          type="text"
          autocomplete="off"
          placeholder="Digite sua dúvida..."
          class="min-w-0 flex-1 bg-transparent py-1.5 font-body text-sm text-bone outline-none placeholder:text-platina"
        />
        <button
          id="assistente-enviar"
          type="submit"
          aria-label="Enviar pergunta"
          class="feni-enviar flex h-9 w-9 shrink-0 items-center justify-center rounded-full transition-[background-color,color,transform] duration-(--dur-hover-btn) ease-(--ease-editorial) active:scale-[0.93]"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 8h12M9 3l5 5-5 5" />
          </svg>
        </button>
      </div>
    </form>

    <a
      href={wa}
      target="_blank"
      rel="noopener"
      class="flex items-center justify-center gap-1.5 border-t border-border px-4 py-3 font-body text-sm font-medium text-platina transition-colors hover:text-gold"
    >
      Prefere falar com a equipe agora? WhatsApp →
    </a>
  </div>

  <button
    id="assistente-abrir"
    type="button"
    aria-label="Abrir assistente Feni"
    aria-expanded="false"
    class="flex h-14 w-14 items-center justify-center rounded-full bg-gold text-midnight shadow-2xl transition-transform duration-(--dur-hover-btn) ease-(--ease-editorial) hover:scale-105 hover:bg-gold-hover active:scale-95"
  >
    <svg id="assistente-icone-chat" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 12a8 8 0 1 1 3.06 6.29L4 20l1.06-3.4A7.96 7.96 0 0 1 4 12Z" />
    </svg>
    <svg id="assistente-icone-fechar" width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" hidden aria-hidden="true">
      <path d="M3 3l10 10M13 3L3 13" />
    </svg>
  </button>
</div>

<style is:global>
  /* `is:global` de propósito, e não é preguiça: o <style> do Astro é escopado
     em tempo de build, marcando só os elementos que existem no template. As
     mensagens aqui nascem de document.createElement no navegador, então não
     recebem o atributo de escopo e o CSS escopado simplesmente não as
     alcança — o avatar virava uma letra solta e a bolha não tinha fundo.
     Todos os nomes levam prefixo `feni-` justamente para poderem ser globais
     sem colidir com nada. */

  /* Avatar da Feni. O original usa um ícone de "sparkles" num gradiente
     indigo; aqui é o retrato dela.
     O anel de gold existe porque o fundo do arquivo (#0C1226) é quase o
     midnight do tema: sem contorno o disco se dissolveria no painel, que é
     um degrau mais claro. */
  .feni-avatar {
    display: block;
    height: 2rem;
    width: 2rem;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-gold) 55%, transparent);
    background: var(--color-midnight);
  }
  .feni-avatar img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .feni-status {
    height: 0.375rem;
    width: 0.375rem;
    border-radius: 9999px;
    background: var(--color-gold);
  }

  /* Linha da mensagem: a fala da Feni entra pela esquerda com o avatar; a
     de quem visita, pela direita e sem avatar — a pessoa sabe quem é ela. */
  .feni-linha {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    animation: feni-entra 350ms var(--ease-editorial) both;
  }
  .feni-linha--eu {
    flex-direction: row-reverse;
  }

  @keyframes feni-entra {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* O canto reto aponta para quem falou — é o detalhe do original que faz a
     bolha parecer sair do avatar em vez de flutuar solta. */
  .feni-bolha {
    max-width: 78%;
    border-radius: 1rem;
    padding: 0.625rem 0.875rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    white-space: pre-line;
  }
  .feni-bolha--feni {
    border-bottom-left-radius: 0.3rem;
    border: 1px solid var(--color-border);
    background: var(--color-midnight-hover);
    color: var(--color-bone);
  }
  .feni-bolha--eu {
    border-bottom-right-radius: 0.3rem;
    background: var(--color-gold);
    color: var(--color-midnight);
  }

  /* Indicador de digitação. Substitui o `animate-bounce` do Tailwind que
     estava aqui: aquele é um salto de 25% da altura pensado para ícone, e
     em três pontos de 6px lia como pipoca. Este é o do componente de
     origem — 4px de subida e a opacidade indo junto, em cascata. */
  .feni-pontinho {
    height: 0.375rem;
    width: 0.375rem;
    border-radius: 9999px;
    background: var(--color-platina);
    animation: feni-pulso 900ms ease-in-out infinite;
  }
  @keyframes feni-pulso {
    0%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-4px);
    }
  }

  /* O botão só acende quando há o que enviar — sem isso ele promete uma ação
     que não acontece. */
  .feni-enviar {
    background: var(--color-midnight-hover);
    color: var(--color-platina);
    cursor: not-allowed;
  }
  .feni-enviar[data-pronto="sim"] {
    background: var(--color-gold);
    color: var(--color-midnight);
    cursor: pointer;
  }
  .feni-enviar[data-pronto="sim"]:hover {
    background: var(--color-gold-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .feni-linha {
      animation: none;
    }
    .feni-pontinho {
      animation: feni-pulso-suave 900ms ease-in-out infinite;
    }
    /* Ainda comunica "estou escrevendo", mas sem deslocamento — gentileza,
       não zero (briefing cap. 06). */
    @keyframes feni-pulso-suave {
      0%,
      100% {
        opacity: 0.35;
      }
      50% {
        opacity: 1;
      }
    }
  }
</style>

<script>
  const root = document.getElementById("assistente-popup") as HTMLDivElement | null;
  const panel = document.getElementById("assistente-panel") as HTMLDivElement | null;
  const openBtn = document.getElementById("assistente-abrir") as HTMLButtonElement | null;
  const closeBtn = document.getElementById("assistente-fechar") as HTMLButtonElement | null;
  const iconChat = document.getElementById("assistente-icone-chat") as SVGElement | null;
  const iconClose = document.getElementById("assistente-icone-fechar") as SVGElement | null;
  const messages = document.getElementById("assistente-mensagens") as HTMLDivElement | null;
  const form = document.getElementById("assistente-form") as HTMLFormElement | null;
  const input = document.getElementById("assistente-input") as HTMLInputElement | null;
  const sendBtn = document.getElementById("assistente-enviar") as HTMLButtonElement | null;

  if (root && panel && openBtn && closeBtn && iconChat && iconClose && messages && form && input && sendBtn) {
    const assistantUrl = root.dataset.assistantUrl ?? "";
    let opened = false;
    let greeted = false;
    let waiting = false;

    // localStorage pode falhar (modo privado, cota cheia) — a sessão
    // sobrevive só na aba atual nesse caso, não é crítico.
    function getSessionId(): string {
      const key = "fenie-assistente-sid";
      const makeId = () =>
        crypto.randomUUID?.() ?? `sid-${Date.now()}-${Math.random().toString(36).slice(2)}`;
      try {
        const existing = localStorage.getItem(key);
        if (existing) return existing;
        const id = makeId();
        localStorage.setItem(key, id);
        return id;
      } catch {
        return makeId();
      }
    }
    const sessionId = getSessionId();

    function scrollToEnd() {
      messages.scrollTop = messages.scrollHeight;
    }

    function atualizarBotao() {
      const pronto = input.value.trim().length > 0 && !waiting;
      sendBtn.dataset.pronto = pronto ? "sim" : "nao";
      sendBtn.disabled = !pronto;
    }

    // Um lugar só para o avatar: ele aparece na fala dela e no indicador de
    // digitação, e quando o retrato chegar é aqui que o disco vira foto.
    function criarAvatar() {
      const avatar = document.createElement("span");
      avatar.className = "feni-avatar";
      avatar.setAttribute("aria-hidden", "true");
      const foto = document.createElement("img");
      foto.src = "/images/assistente/feni.webp";
      foto.alt = "";
      foto.width = 256;
      foto.height = 256;
      avatar.appendChild(foto);
      return avatar;
    }

    function addMessage(text: string, from: "feni" | "eu") {
      const linha = document.createElement("div");
      linha.className = `feni-linha feni-linha--${from}`;

      if (from === "feni") linha.appendChild(criarAvatar());

      const bolha = document.createElement("p");
      bolha.className = `feni-bolha feni-bolha--${from}`;
      bolha.textContent = text;
      linha.appendChild(bolha);

      messages.appendChild(linha);
      scrollToEnd();
      return linha;
    }

    function addTypingIndicator() {
      const linha = document.createElement("div");
      linha.className = "feni-linha feni-linha--feni";
      linha.id = "assistente-digitando";

      linha.appendChild(criarAvatar());

      const bolha = document.createElement("div");
      bolha.className = "feni-bolha feni-bolha--feni flex items-center gap-1.5 py-3.5";
      // aria-label porque três pontinhos não dizem nada a quem não vê a tela
      bolha.setAttribute("role", "status");
      bolha.setAttribute("aria-label", "Feni está escrevendo");
      for (let i = 0; i < 3; i += 1) {
        const ponto = document.createElement("span");
        ponto.className = "feni-pontinho";
        ponto.style.animationDelay = `${i * 150}ms`;
        bolha.appendChild(ponto);
      }
      linha.appendChild(bolha);

      messages.appendChild(linha);
      scrollToEnd();
      return { linha, bolha };
    }

    function openPanel() {
      opened = true;
      panel.hidden = false;
      openBtn.setAttribute("aria-expanded", "true");
      iconChat.hidden = true;
      iconClose.hidden = false;
      if (!greeted) {
        greeted = true;
        // Saudação no tom da persona: direta, sem "Olá! Como posso ajudar?",
        // e honesta sobre o que ela é.
        addMessage(
          "Oi, eu sou a Feni — a assistente virtual da Fenié. Pergunta o que precisar sobre as marcas, o atendimento ou a Academy.",
          "feni"
        );
      }
      atualizarBotao();
      requestAnimationFrame(() => input.focus());
    }

    function closePanel() {
      opened = false;
      panel.hidden = true;
      openBtn.setAttribute("aria-expanded", "false");
      iconChat.hidden = false;
      iconClose.hidden = true;
    }

    openBtn.addEventListener("click", () => (opened ? closePanel() : openPanel()));
    closeBtn.addEventListener("click", closePanel);
    input.addEventListener("input", atualizarBotao);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && opened) closePanel();
    });
    atualizarBotao();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const pergunta = input.value.trim();
      if (!pergunta || waiting) return;

      if (!assistantUrl) {
        addMessage(pergunta, "eu");
        input.value = "";
        atualizarBotao();
        addMessage(
          "O assistente ainda não está ativo por aqui — mas dá pra falar direto com a equipe pelo WhatsApp aí embaixo.",
          "feni"
        );
        return;
      }

      addMessage(pergunta, "eu");
      input.value = "";
      waiting = true;
      atualizarBotao();

      const typing = addTypingIndicator();
      // o modelo gratuito às vezes demora — avisa sem deixar parecer travado
      const patienceTimer = window.setTimeout(() => {
        typing.bolha.replaceChildren();
        typing.bolha.classList.remove("py-3.5");
        typing.bolha.removeAttribute("role");
        typing.bolha.removeAttribute("aria-label");
        typing.bolha.textContent = "Só um instante, já te respondo…";
      }, 7000);

      const controller = new AbortController();
      const abortTimer = window.setTimeout(() => controller.abort(), 75000);

      try {
        const response = await fetch(assistantUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ pergunta, sessionId }),
          signal: controller.signal,
        });
        if (!response.ok) {
          const bodyText = await response.text().catch(() => "");
          throw new Error(`HTTP ${response.status} ${bodyText.slice(0, 200)}`);
        }
        const data = await response.json();
        typing.linha.remove();
        addMessage(
          typeof data.resposta === "string" && data.resposta
            ? data.resposta
            : "Não consegui responder agora — tenta de novo ou chama a gente no WhatsApp aí embaixo.",
          "feni"
        );
      } catch {
        typing.linha.remove();
        addMessage(
          "Deu um problema pra responder agora. Chama a gente direto no WhatsApp aí embaixo que a equipe continua o atendimento.",
          "feni"
        );
      } finally {
        window.clearTimeout(patienceTimer);
        window.clearTimeout(abortTimer);
        waiting = false;
        atualizarBotao();
      }
    });
  }
</script>
