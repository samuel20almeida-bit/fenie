---
import { marcaDestaque, marcasSecundarias } from "../data/marcas";
import { whatsappLink } from "../lib/whatsapp";

interface Props {
  /** Na página /marcas o título da seção já está no hero — não repetir. */
  showHeading?: boolean;
}

const { showHeading = true } = Astro.props;
const destaque = marcaDestaque.destaque!;

// Logos oficiais das marcas são pretos sobre fundo branco: ficam ilegíveis
// direto no midnight, por isso cada um vive numa placa clara. Bone em vez
// de branco puro: mantém o logo legível sem quebrar o clima editorial
// escuro do resto do site com 6 retângulos branco-puro em sequência.
const plateClass =
  "flex h-18 items-center justify-center rounded-editorial bg-bone p-3.5 sm:h-24 sm:p-5";
---

<section class="bg-midnight py-26">
  <div class="container-editorial">
    {
      showHeading ? (
        <div class="reveal mb-12 flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-[52ch]">
            <h2 class="text-[clamp(1.8rem,3vw,2.4rem)]">Marcas parceiras</h2>
            <p class="mt-4 text-platina">
              Um portfólio selecionado para diferentes serviços, técnicas e rotinas do salão.
            </p>
          </div>
          <a href="/marcas" class="border-b border-gold pb-0.5 text-sm font-semibold">
            Ver todas as marcas →
          </a>
        </div>
      ) : (
        // A página que embute o grid sem repetir o título (/marcas) já tem "Marcas
        // parceiras" no h1 do hero — este h2 fica só pra hierarquia de heading não
        // pular do h1 direto pros h3 dos cards.
        <h2 class="sr-only">Marcas parceiras</h2>
      )
    }

    {
      /* Duas colunas já no mobile: em coluna única as seis marcas viravam uma
      lista de rolagem sem fim e o portfólio deixava de ser lido como conjunto.
      A marca em destaque continua ocupando a largura toda. */
    }
    <div class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-[1.3fr_1fr_1fr] lg:grid-rows-3">
      <div
        class="reveal group col-span-2 flex flex-col gap-4.5 rounded-editorial border border-border-subtle bg-midnight-card p-6 transition-[color,background-color,border-color,transform] duration-(--dur-hover-card) ease-(--ease-editorial) hover:border-gold sm:p-7 lg:col-span-1 lg:row-span-3 pointer-fine:hover:-translate-y-0.5"
      >
        <div class="flex flex-1 items-center justify-center rounded-editorial bg-midnight-hover p-5">
          <img
            src={destaque.imagem}
            alt={destaque.imagemAlt}
            class="max-h-70 w-full object-contain"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div>
          <p class="eyebrow mb-2.5">{destaque.eyebrow}</p>
          <h3 class="font-body text-feature font-bold">{marcaDestaque.nome}</h3>
          <p class="mt-2.5 max-w-[42ch] text-sm text-platina">{destaque.resumo}</p>
          <div class="mt-3.5 flex flex-wrap gap-5">
            <a
              href={marcaDestaque.href}
              class="border-b border-gold pb-0.5 text-caption font-semibold"
            >
              Conhecer a marca →
            </a>
            <a
              href="/academy#agenda"
              class="border-b border-border-subtle pb-0.5 text-caption font-semibold text-platina hover:border-gold hover:text-gold"
            >
              Ver agenda da Academy →
            </a>
          </div>
        </div>
      </div>

      {
        marcasSecundarias.map((marca, i) => (
          <div
            class="reveal group flex flex-col gap-3.5 rounded-editorial border border-border-subtle bg-midnight-card p-4 transition-[border-color,transform] duration-(--dur-hover-card) ease-(--ease-editorial) hover:border-gold sm:gap-4 sm:p-6 pointer-fine:hover:-translate-y-0.5"
            style={`transition-delay: ${i * 75}ms`}
          >
            <div class={plateClass}>
              <img
                src={marca.logo}
                alt={`Logo ${marca.nome}`}
                class="h-full w-full object-contain"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="flex flex-1 flex-col justify-end">
              <p class="eyebrow mb-1.5 text-platina">Marca parceira</p>
              <h3 class="font-body text-h3 font-bold">{marca.nome}</h3>
              <a
                href={whatsappLink(`Olá! Quero saber mais sobre a marca ${marca.nome} na Fenié Pro.`)}
                class="mt-2.5 self-start border-b border-border-subtle pb-0.5 text-caption font-semibold text-platina transition-colors duration-(--dur-hover-btn) ease-(--ease-editorial) hover:border-gold hover:text-gold"
              >
                Falar sobre a marca →
              </a>
            </div>
          </div>
        ))
      }
    </div>

    {
      /* Fecha o portfólio ligando curadoria a consultoria: sem isso a seção
      termina como catálogo, e a escolha da linha certa — que é justamente o
      trabalho da Fenié — fica por conta do visitante. */
    }
    <div class="reveal mt-12 flex flex-wrap items-center justify-between gap-x-10 gap-y-5 border-t border-border-subtle pt-9">
      <p class="max-w-[46ch] font-body text-feature font-semibold text-bone">
        Não sabe qual marca faz mais sentido para a sua operação?
      </p>
      <a
        href={whatsappLink(
          "Olá! Quero ajuda para escolher as marcas que fazem sentido para o meu salão."
        )}
        class="border-b border-gold pb-0.5 text-sm font-semibold text-bone transition-colors duration-(--dur-hover-btn) ease-(--ease-editorial) hover:text-gold"
      >
        Falar com um consultor →
      </a>
    </div>
  </div>
</section>
