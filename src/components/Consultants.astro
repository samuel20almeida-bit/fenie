---
import Button from "./Button.astro";
import { whatsappLink } from "../lib/whatsapp";

const team = [
  { name: "Osvaldir Niejelski", role: "CEO" },
  { name: "Ricardo Souza", role: "Diretor de Marketing e Comercial" },
];
---

<section class="bg-midnight py-26">
  <div class="container-editorial">
    <div class="reveal mb-12 max-w-[60ch]">
      <h2 class="text-[clamp(1.7rem,2.8vw,2.2rem)]">Time Fenié.</h2>
      <p class="mt-4 max-w-[52ch] text-platina">
        As pessoas à frente da Fenié: de quem decide o rumo da empresa a quem toca o comercial e o
        relacionamento com o salão no dia a dia.
      </p>
    </div>

    <div class="reveal flex flex-col divide-y divide-white/10 border-t border-white/10 sm:flex-row sm:divide-x sm:divide-y-0 sm:border-t-0 sm:border-b">
      {
        team.map((p) => (
          <div class="flex flex-1 items-center gap-4 py-6 sm:px-8 sm:py-0 first:sm:pl-0">
            <div
              class="h-14 w-14 shrink-0 rounded-full border border-white/10 bg-midnight-card"
              style="background-image: repeating-linear-gradient(135deg, color-mix(in oklab, var(--color-gold) 10%, transparent) 0px, color-mix(in oklab, var(--color-gold) 10%, transparent) 1px, transparent 1px, transparent 15px);"
              aria-hidden="true"
            />
            <div>
              <h3 class="font-body text-[0.98rem] font-bold">{p.name}</h3>
              <p class="mt-0.5 text-[0.82rem] text-platina">{p.role}</p>
            </div>
          </div>
        ))
      }
    </div>

    <Button href={whatsappLink("Olá! Quero falar com a equipe da Fenié Pro.")} class="mt-9">
      Falar com a equipe Fenié
    </Button>
  </div>
</section>
