---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AssistantePopup from "../components/AssistantePopup.astro";
import { empresa, mapaLink } from "../data/empresa";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = "/images/og-default.jpg" } = Astro.props;
const pageTitle = `${title} · Fenié Pro`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// LocalBusiness: distribuição profissional com endereço fixo em Curitiba.
// Sem CEP e sem geo porque o site anterior não publica nenhum dos dois —
// preencher assim que a informação for confirmada, não chutar.
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": new URL("/#organizacao", Astro.site).href,
  name: "Fenié Pro",
  description: empresa.descricaoCurta,
  url: new URL("/", Astro.site).href,
  telephone: empresa.telefoneE164,
  email: empresa.email,
  image: new URL("/images/og-default.jpg", Astro.site).href,
  hasMap: mapaLink,
  address: {
    "@type": "PostalAddress",
    streetAddress: empresa.endereco.logradouro,
    addressLocality: empresa.endereco.cidade,
    addressRegion: empresa.endereco.uf,
    addressCountry: empresa.endereco.pais,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: empresa.horarioDias,
      opens: empresa.horarioAbre,
      closes: empresa.horarioFecha,
    },
  ],
  areaServed: { "@type": "City", name: "Curitiba" },
  sameAs: empresa.redes.map((rede) => rede.href),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fenié Pro" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} is:inline />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400..900;1,400..900&family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <AssistantePopup />

    <script>
      // Entrada por scroll — 550ms, once (briefing cap. 06). Reanimar na
      // volta vira pisca-pisca: por isso o observer some depois do 1º hit.
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.25 }
      );
      items.forEach((item) => observer.observe(item));
    </script>
  </body>
</html>
