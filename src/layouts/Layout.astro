---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AssistantePopup from "../components/AssistantePopup.astro";
import { empresa, mapaLink } from "../data/empresa";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = "/images/og-default.jpg" } = Astro.props;
const pageTitle = `${title} · Fenié Pro`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// LocalBusiness: distribuição profissional com endereço fixo em Curitiba.
// Sem CEP e sem geo porque o site anterior não publica nenhum dos dois —
// preencher assim que a informação for confirmada, não chutar.
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": new URL("/#organizacao", Astro.site).href,
  name: "Fenié Pro",
  description: empresa.descricaoCurta,
  url: new URL("/", Astro.site).href,
  telephone: empresa.telefoneE164,
  email: empresa.email,
  image: new URL("/images/og-default.jpg", Astro.site).href,
  hasMap: mapaLink,
  address: {
    "@type": "PostalAddress",
    streetAddress: empresa.endereco.logradouro,
    addressLocality: empresa.endereco.cidade,
    addressRegion: empresa.endereco.uf,
    addressCountry: empresa.endereco.pais,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: empresa.horarioDias,
      opens: empresa.horarioAbre,
      closes: empresa.horarioFecha,
    },
  ],
  areaServed: { "@type": "City", name: "Curitiba" },
  sameAs: empresa.redes.map((rede) => rede.href),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fenié Pro" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} is:inline />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;1,400&family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <noscript>
      <style>
        /* Sem JS o IntersectionObserver nunca marca .is-visible, e todo o
           conteúdo do site — que é quase todo .reveal — ficaria em opacity 0.
           Bug antigo, encontrado ao testar o fallback do trilho.

           `:root .reveal` e não `.reveal`: o Astro injeta este <noscript>
           ANTES do CSS do site, então em empate de especificidade quem vem
           depois ganha — e quem vem depois é o opacity: 0. Com (0,2,0) a
           ordem deixa de importar. */
        :root .reveal {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <AssistantePopup />

    <script>
      // Entrada por scroll — 550ms, once (briefing cap. 06). Reanimar na
      // volta vira pisca-pisca: por isso o observer some depois do 1º hit.
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.25 }
      );
      items.forEach((item) => observer.observe(item));
    </script>

    <script>
      // Trilho de passos — porte do "PassosNaLinha" (React + motion) para JS
      // vanilla, que é a regra do projeto. Ver global.css para as decisões de
      // desenho; aqui fica só o que move.
      //
      // Nada acontece se a pessoa pediu para não ter animação: o CSS já pinta
      // o estado final, então sair daqui sem fazer nada entrega fio cheio e
      // pontos acesos. O mesmo vale se este script não carregar.
      const semMovimento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const trilhos = [...document.querySelectorAll<HTMLElement>("[data-trilho]")];

      if (trilhos.length && !semMovimento) {
        // Janela do original: o fio começa a encher quando o topo da lista
        // chega a 78% da altura da janela e termina quando o fim dela passa
        // de 65%. Numa janela curta demais o fio enche antes de a pessoa ler
        // o primeiro passo, e o efeito perde a função.
        const INICIO = 0.78;
        const FIM = 0.65;
        // Mesma mola do original (framer-motion). Ela existe porque o
        // progresso cru é áspero: acompanha o tranco da roda do mouse pixel a
        // pixel, e sem ela o fio anda em degraus.
        const RIGIDEZ = 110;
        const AMORTECIMENTO = 28;

        const estados = trilhos.map((el) => ({
          el,
          cheio: el.querySelector<HTMLElement>(".trilho-cheio"),
          acesos: [...el.querySelectorAll<HTMLElement>(".trilho-aceso")],
          x: 0,
          v: 0,
          alvo: 0,
        }));

        function alvoDe(el: HTMLElement) {
          const r = el.getBoundingClientRect();
          const vh = window.innerHeight;
          const percorrido = INICIO * vh - r.top;
          const total = (INICIO - FIM) * vh + r.height;
          return Math.min(1, Math.max(0, percorrido / total));
        }

        function pintar(e: (typeof estados)[number]) {
          if (e.cheio) e.cheio.style.transform = `scaleY(${e.x})`;
          const total = e.acesos.length;
          e.acesos.forEach((aceso, i) => {
            // Acende quando o preenchimento chega no ponto e completa em meio
            // passo: com transição instantânea o número piscava no limiar.
            const inicio = i / total;
            const p = (e.x - inicio) / (0.5 / total);
            aceso.style.opacity = String(Math.min(1, Math.max(0, p)));
          });
        }

        // Estado inicial aplicado de imediato, antes do primeiro quadro: sem
        // isso o fio cheio do CSS aparece por um instante e depois esvazia.
        for (const e of estados) {
          e.x = e.alvo = alvoDe(e.el);
          pintar(e);
        }

        const visiveis = new Set<HTMLElement>();
        const io = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              const alvo = entrada.target as HTMLElement;
              if (entrada.isIntersecting) visiveis.add(alvo);
              else visiveis.delete(alvo);
            }
            if (visiveis.size && !quadroId) quadroId = requestAnimationFrame(quadro);
          },
          // margem larga para o fio já estar no ponto certo quando a seção
          // entra na tela, não começando do zero na borda
          { rootMargin: "40% 0px 40% 0px" }
        );
        estados.forEach((e) => io.observe(e.el));

        let quadroId = 0;
        let anterior = 0;

        function quadro(agora: number) {
          const dt = Math.min(anterior ? (agora - anterior) / 1000 : 0.016, 1 / 30);
          anterior = agora;
          let parado = true;

          for (const e of estados) {
            if (!visiveis.has(e.el)) continue;
            e.alvo = alvoDe(e.el);
            // integração semi-implícita: acelera para o alvo e freia pela
            // velocidade, que é o modelo de mola do original
            e.v += ((e.alvo - e.x) * RIGIDEZ - e.v * AMORTECIMENTO) * dt;
            e.x += e.v * dt;
            if (Math.abs(e.alvo - e.x) > 0.0005 || Math.abs(e.v) > 0.0005) parado = false;
            else {
              e.x = e.alvo;
              e.v = 0;
            }
            pintar(e);
          }

          // Para o laço quando tudo assentou. Ele volta no próximo scroll,
          // porque o próprio scroll muda o alvo e o observer religa.
          if (parado || !visiveis.size) {
            quadroId = 0;
            anterior = 0;
          } else {
            quadroId = requestAnimationFrame(quadro);
          }
        }

        const religar = () => {
          if (visiveis.size && !quadroId) quadroId = requestAnimationFrame(quadro);
        };
        window.addEventListener("scroll", religar, { passive: true });
        window.addEventListener("resize", religar);
      }
    </script>
  </body>
</html>
