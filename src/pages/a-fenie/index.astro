---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import Metodo from "../../components/Metodo.astro";
import Depoimentos from "../../components/Depoimentos.astro";
import CtaFinal from "../../components/CtaFinal.astro";
import { whatsappLink } from "../../lib/whatsapp";
import {
  declaracao,
  diferenciais,
  missao,
  motivos,
  numeros,
  visao,
} from "../../data/institucional";
---

<Layout
  title="A Fenié"
  description="A Fenié Pro conecta produtos profissionais, conhecimento técnico e suporte comercial para o salão trabalhar com mais segurança, resultado e crescimento."
>
  <section class="pt-33 pb-6">
    <div class="container-editorial">
      <div class="max-w-160">
        <p class="eyebrow mb-5">Institucional</p>
        <h1 class="text-[clamp(2.1rem,4.4vw,3.4rem)]">
          Deixar de ser onde eu compro e passar a ser com quem eu <em>cresço</em>.
        </h1>
        <p class="mt-6 text-lg text-platina">
          A Fenié Pro conecta produtos profissionais, conhecimento técnico e suporte comercial para
          o salão trabalhar com mais segurança, resultado e crescimento.
        </p>
      </div>
    </div>
  </section>

  <section class="py-8">
    <div class="container-editorial">
      <div class="grid gap-8 border-t border-border-subtle pt-14 max-w-160 md:grid-cols-[auto_1fr] md:gap-x-14">
        <div class="flex items-baseline gap-3 md:contents">
          <p class="eyebrow shrink-0 text-platina line-through decoration-platina/40">Sai</p>
          <p class="font-body text-h3 text-platina italic">
            "Somos uma distribuidora e temos estes produtos."
          </p>
        </div>
        <div class="mt-8 flex items-baseline gap-3 md:contents">
          <p class="eyebrow shrink-0">Entra</p>
          <p class="font-body text-lg font-medium text-bone">
            "Conectamos produtos profissionais, conhecimento técnico e suporte comercial para o
            salão trabalhar com mais segurança, resultado e crescimento."
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-19">
    <div class="container-editorial">
      <div class="reveal grid gap-px border border-border-subtle bg-border-subtle md:grid-cols-2">
        <div class="bg-midnight p-9">
          <p class="eyebrow mb-3.5">Nossa missão</p>
          <p class="max-w-[42ch] font-body text-base text-bone">{missao}</p>
        </div>
        <div class="bg-midnight p-9">
          <p class="eyebrow mb-3.5">Nossa visão</p>
          <p class="max-w-[42ch] font-body text-base text-bone">{visao}</p>
        </div>
      </div>

      <dl class="reveal mt-12 grid grid-cols-2 gap-x-8 gap-y-10 border-t border-gold/40 pt-9 md:grid-cols-4">
        {
          numeros.map((n, i) => (
            <div style={`transition-delay: ${i * 75}ms`}>
              <dt class="text-[clamp(1.9rem,3.4vw,2.6rem)] leading-none font-bold tracking-tight">
                {n.valor}
              </dt>
              <dd class="mt-2.5 max-w-[22ch] font-mono text-micro tracking-wide text-platina uppercase">
                {n.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="bg-midnight pb-19">
    <div class="container-editorial">
      <div class="grid gap-12 border-t border-border-subtle pt-14 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
        <div class="reveal">
          <p class="eyebrow mb-4">Sobre a Fenié</p>
          <h2 class="max-w-[22ch] text-[clamp(1.6rem,2.8vw,2.1rem)]">{declaracao.titulo}</h2>
          <p class="mt-5 max-w-[52ch] text-platina">{declaracao.texto}</p>

          <div class="mt-9 w-15 border-t border-gold" aria-hidden="true"></div>
          <p class="mt-4 font-body text-h3 font-bold">{declaracao.assinatura.nome}</p>
          <p class="mt-0.5 font-mono text-micro tracking-wide text-platina uppercase">
            {declaracao.assinatura.cargo}
          </p>
        </div>

        <ul class="reveal self-start border-t border-border-subtle">
          {
            diferenciais.map((item) => (
              <li class="flex items-start gap-3.5 border-b border-border-subtle py-3.5">
                <span class="mt-[9px] h-1 w-1 shrink-0 rounded-full bg-gold" aria-hidden="true" />
                <span class="font-body text-base text-bone">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Metodo />

  <section class="bg-midnight py-26">
    <div class="container-editorial">
      <div class="reveal mb-12 max-w-[60ch]">
        <p class="eyebrow mb-4">Insatisfeito com o distribuidor atual?</p>
        <h2 class="text-[clamp(1.8rem,3vw,2.4rem)]">
          Por que salões estão <em>migrando</em> para a Fenié.
        </h2>
      </div>

      <div class="max-w-216 border-t border-border-subtle">
        {
          motivos.map((m, i) => (
            <div
              class="reveal grid grid-cols-[44px_1fr] items-baseline gap-x-6 gap-y-1 border-b border-border-subtle py-7 md:grid-cols-[64px_1fr_auto]"
              style={`transition-delay: ${i * 75}ms`}
            >
              <p class="eyebrow text-platina">{m.n}</p>
              <h3 class="font-body text-h3 font-semibold">{m.titulo}</h3>
              <p class="col-start-2 font-body text-base text-platina italic md:col-start-3 md:text-right">
                {m.contra}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Depoimentos />

  <section class="bg-midnight py-26">
    <div class="container-editorial">
      <div class="max-w-160">
        <p class="eyebrow mb-5">Presença próxima</p>
        <h2 class="text-[clamp(1.7rem,2.8vw,2.2rem)]">
          Atendimento profissional com base em Curitiba.
        </h2>
        <p class="mt-4 max-w-[52ch] text-platina">
          A Fenié atua a partir de Curitiba e atende profissionais e salões conforme sua operação
          comercial e rotas regionais. Entre em contato para confirmar disponibilidade, prazo e
          condições para sua cidade.
        </p>
        <Button
          href={whatsappLink("Olá! Quero consultar o atendimento da Fenié na minha região.")}
          variant="outline"
          class="mt-7"
        >
          Consultar atendimento na minha região →
        </Button>
      </div>
    </div>
  </section>

  <CtaFinal />
</Layout>
